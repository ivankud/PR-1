{
  "type": "image",
  "name": "Изображение",
  "icon": "🖼️",
  "defaults": {
    "position": "absolute",
    "width": 200,
    "height": 150,
    "left": 0,
    "top": 0,
    "style": {
      "border": "1px solid #cccccc",
      "borderRadius": "4px",
      "objectFit": "cover"
    }
  },
  "properties": [
    { "name": "position", "label": "Позиция", "type": "select", "options": ["", "absolute", "relative", "static", "fixed", "sticky"], "default": "absolute" },
    { "name": "src", "label": "URL изображения", "type": "string", "default": "https://via.placeholder.com/200x150" },
    { "name": "alt", "label": "Альт. текст", "type": "string", "default": "Изображение" },
    { "name": "width", "label": "Ширина", "type": "number" },
    { "name": "height", "label": "Высота", "type": "number" },
    { "name": "left", "label": "X (left)", "type": "number" },
    { "name": "top", "label": "Y (top)", "type": "number" }
  ],
  "anchors": [
    { "name": "src", "path": "image.src", "description": "URL изображения из контекста" }
  ],
  "render": {
    "tag": "img",
    "attributes": {
      "src": "{{src}}",
      "alt": "{{alt}}"
    }
  }
}