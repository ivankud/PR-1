{
  "type": "textarea",
  "name": "Многострочный текст",
  "icon": "📄",
  "defaults": {
    "position": "absolute",
    "width": 250,
    "height": 80,
    "left": 0,
    "top": 0,
    "style": {
      "border": "1px solid #cccccc",
      "borderRadius": "4px",
      "padding": "4px 8px",
      "fontSize": "14px",
      "resize": "none"
    }
  },
  "properties": [
    { "name": "position", "label": "Позиция", "type": "select", "options": ["", "absolute", "relative", "static", "fixed", "sticky"], "default": "absolute" },
    { "name": "placeholder", "label": "Подсказка", "type": "string", "default": "Введите текст..." },
    { "name": "value", "label": "Значение", "type": "string", "default": "" },
    { "name": "name", "label": "Имя поля", "type": "string", "default": "textarea" },
    { "name": "width", "label": "Ширина", "type": "number" },
    { "name": "height", "label": "Высота", "type": "number" },
    { "name": "left", "label": "X (left)", "type": "number" },
    { "name": "top", "label": "Y (top)", "type": "number" }
  ],
  "anchors": [
    { "name": "value", "path": "textarea.value", "description": "Значение из контекста" },
    { "name": "placeholder", "path": "textarea.placeholder", "description": "Подсказка из контекста" }
  ],
  "render": {
    "tag": "textarea",
    "text": "{{value}}",
    "attributes": {
      "placeholder": "{{placeholder}}",
      "name": "{{name}}"
    }
  }
}