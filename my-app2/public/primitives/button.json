{
  "type": "button",
  "name": "Кнопка",
  "icon": "🔘",
  "defaults": {
    "position": "absolute",
    "width": 120,
    "height": 40,
    "left": 0,
    "top": 0,
    "style": {
      "display": "inline-flex",
      "alignItems": "center",
      "justifyContent": "center",
      "backgroundColor": "#007bff",
      "color": "#ffffff",
      "border": "none",
      "borderRadius": "4px",
      "fontSize": "14px",
      "cursor": "pointer"
    }
  },
  "properties": [
    { "name": "text", "label": "Текст", "type": "string", "default": "Кнопка" },
    { "name": "icon", "label": "Иконка", "type": "icon", "default": "" },
    { "name": "iconSize", "label": "Размер иконки", "type": "number", "default": 16 },
    { "name": "position", "label": "Позиция", "type": "select", "options": ["", "absolute", "relative", "static", "fixed", "sticky"] },
    { "name": "width", "label": "Ширина", "type": "number" },
    { "name": "height", "label": "Высота", "type": "number" },
    { "name": "left", "label": "X (left)", "type": "number" },
    { "name": "top", "label": "Y (top)", "type": "number" }
  ],
  "anchors": [
    { "name": "text", "path": "button.text", "description": "Текст кнопки из контекста" }
  ],
  "render": {
    "tag": "button",
    "text": "{{text}}",
    "attributes": {
      "type": "button"
    }
  }
}