{
  "type": "input",
  "name": "Поле ввода",
  "icon": "📝",
  "defaults": {
    "width": 200,
    "height": 35,
    "left": 0,
    "top": 0,
    "inputType": "text",
    "style": {
      "border": "1px solid #cccccc",
      "borderRadius": "4px",
      "padding": "4px 8px",
      "fontSize": "14px"
    }
  },
  "properties": [
    { "name": "inputType", "label": "Тип значения", "type": "select", "options": ["text", "number", "date", "time"], "default": "text" },
    { "name": "placeholder", "label": "Подсказка", "type": "string", "default": "Введите текст..." },
    { "name": "value", "label": "Значение", "type": "string", "default": "" },
    { "name": "defaultValue", "label": "Начальное значение", "type": "string", "default": "" },
    { "name": "readOnly", "label": "Только чтение (отключить редактирование)", "type": "boolean", "default": false },
    { "name": "name", "label": "Имя поля", "type": "string", "default": "input" },
    { "name": "width", "label": "Ширина", "type": "number" },
    { "name": "height", "label": "Высота", "type": "number" },
    { "name": "left", "label": "X (left)", "type": "number" },
    { "name": "top", "label": "Y (top)", "type": "number" }
  ],
  "anchors": [
    { "name": "value", "path": "input.value", "description": "Значение из контекста" },
    { "name": "placeholder", "path": "input.placeholder", "description": "Подсказка из контекста" },
    { "name": "defaultValue", "path": "input.defaultValue", "description": "Начальное значение (редактируемое поле)" }
  ],
  "render": {
    "tag": "input",
    "attributes": {
      "type": "{{inputType}}",
      "placeholder": "{{placeholder}}",
      "defaultValue": "{{defaultValue}}",
      "value": "{{value}}",
      "readOnly": "{{readOnly}}",
      "name": "{{name}}"
    }
  }
}