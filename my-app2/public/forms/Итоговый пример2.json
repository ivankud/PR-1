  "functions": [
    {
      "id": "fn-on-open",
      "name": "onOpenHandler",
      "description": "Иллюстрация события onOpen: выполняется при открытии формы, добавляет метку в контекст",
      "code": "console.log('Событие onOpen: форма открыта');\ncontext.eventLog = (context.eventLog || '') + 'onOpen; ';\ncontext.onOpenMessage = 'Событие onOpen выполнено при открытии формы';\nreturn context;"
    },
    {
      "id": "fn-on-load",
      "name": "onLoadHandler",
      "description": "Иллюстрация события onLoad: выполняется после загрузки контекста, добавляет метку в контекст",
      "code": "console.log('Событие onLoad: контекст загружен');\ncontext.eventLog = (context.eventLog || '') + 'onLoad; ';\ncontext.onLoadMessage = 'Событие onLoad выполнено после загрузки контекста';\nreturn context;"
    },
    {
      "id": "fn-on-submit",
      "name": "onSubmitHandler",
      "description": "Иллюстрация события onSubmit: выполняется при отправке формы, добавляет метку в контекст",
      "code": "console.log('Событие onSubmit: форма отправлена');\ncontext.eventLog = (context.eventLog || '') + 'onSubmit; ';\ncontext.onSubmitMessage = 'Событие onSubmit выполнено при отправке формы';\nreturn context;"
    }
  ],
  "events": {
    "onOpen": "onOpenHandler",
    "onLoad": "onLoadHandler",
    "onSubmit": "onSubmitHandler"
  },
